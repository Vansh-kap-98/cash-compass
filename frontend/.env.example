# Copy to .env and fill in the values from your Supabase project:
#   Dashboard -> Settings -> API Keys
#
# Use the anon / public key. Never the service_role key: it bypasses RLS
# entirely, and anything in a Vite build ships to the browser.
#
# .env is gitignored; this file is committed and must only ever hold
# placeholders.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
